{
  "_comment": "Copy to ~/.multi-model-relay/config.json. Model ids must match what your agent platform uses. Never commit real API keys.",
  "backend": "auto",
  "slots": {
    "A": { "model": "claude-opus-5-5", "effort": "high" },
    "B": { "model": "claude-fable-5-1", "effort": "high" },
    "C": { "model": "gpt-6-astra", "effort": "high" }
  },
  "rounds": ["A", "B", "C"],
  "executor": { "model": "", "effort": "high" },
  "verifier_slot": "C",
  "pause_each_round": false,
  "providers": {
    "source": "workbuddy",
    "custom": [
      {
        "id": "example-custom-model",
        "url": "https://api.example.com/v1",
        "api_key_env": "EXAMPLE_API_KEY",
        "model_id": "example-model-id-sent-to-api",
        "efforts": ["low", "medium", "high"]
      }
    ]
  },
  "limits": {
    "max_input_chars": 60000,
    "timeout_s": 900
  }
}
